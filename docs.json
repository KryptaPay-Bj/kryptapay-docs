{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "almond",
  "name": "KryptaPay API",
  "colors": {
    "primary": "#0E0099",
    "light": "#3a2ec1",
    "dark": "#03001e"
  },
  "favicon": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Essentials",
            "pages": [
              "requests-and-responses",
              "errors",
              "networks",
              "webhooks"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "payins",
              "payouts"
            ]
          },
          {
            "group": "Go live",
            "pages": [
              "compliance",
              "going-live"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Payins",
            "pages": [
              "api-reference/payins/create",
              "api-reference/payins/confirm-otp",
              "api-reference/payins/get"
            ]
          },
          {
            "group": "Payouts",
            "pages": [
              "api-reference/payouts/create",
              "api-reference/payouts/list",
              "api-reference/payouts/get",
              "api-reference/payouts/cancel"
            ]
          },
          {
            "group": "Fees",
            "pages": [
              "api-reference/fees/quote"
            ]
          },
          {
            "group": "FX",
            "pages": [
              "api-reference/fx/rates",
              "api-reference/fx/quote",
              "api-reference/fx/convert"
            ]
          },
          {
            "group": "Wallets",
            "pages": [
              "api-reference/wallets/list",
              "api-reference/wallets/get"
            ]
          },
          {
            "group": "Transactions",
            "pages": [
              "api-reference/transactions/list",
              "api-reference/transactions/get"
            ]
          },
          {
            "group": "Networks and status",
            "pages": [
              "api-reference/networks/list",
              "api-reference/status/get"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.png",
    "dark": "/images/logo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@krypta-pay.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.krypta-pay.com/app/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "One API to collect and pay out across Africa — Mobile Money, bank transfers and stablecoins.",
  "markdown": {
    "schema": true
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python", "php"]
    }
  },
  "redirects": [
    { "source": "/getting-started", "destination": "/quickstart" },
    { "source": "/using-the-api", "destination": "/quickstart" },
    { "source": "/core-concepts", "destination": "/" },
    { "source": "/testing", "destination": "/errors" },
    { "source": "/providers", "destination": "/networks" },
    { "source": "/deposits", "destination": "/payins" },
    { "source": "/api-reference", "destination": "/api-reference/introduction" }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/KryptaPay"
    }
  }
}
